//@version=5
// ============================================================================
// NQ Sweep+Reclaim Scalper — v1
//
// Setup: At every 15-min reference candle close during the NY session, the
// candle's High and Low become magnet levels for the next 15-min trade window.
// We wait for one of two patterns inside that window:
//
//   LONG  : reference LOW gets swept (price prints below ref_L by `buf` ticks),
//           then a subsequent 30s bar CLOSES back above ref_L within
//           `reclaim_window` bars. Entry = reclaim bar's close.
//   SHORT : mirror — sweep ref_H then close back below.
//
// The thesis: a magnet level gets tagged ~90% of the time (data), but the
// open question is what happens AFTER. A sweep+reclaim is the market PRINTING
// the rejection — much higher confidence than blind fade. Stop sits at the
// swept extreme (natural invalidation), but capped at `stop_max_pts` to
// enforce a 1:1 scalp box. Target is a fixed point distance.
//
// Optional 200MA regime filter (recommended): only takes longs above 15m
// 200MA and shorts below. Filters out the trending-against-magnet days where
// fades die.
//
// Built for NQ on 30s chart, NY session (9:30 - 15:45 ET).
// Data backing: analyses/extended-stats/06-midpoint-mean-reversion (78.92%),
//   /retest-conditional-stats (97% w/ VWAP confluence),
//   /929-followthrough, /asia-candle-hit-stats sweep counts.
// ============================================================================
indicator("NQ Sweep+Reclaim Scalp v1", overlay=true, max_lines_count=500, max_labels_count=500)

// ---- Inputs: window ---------------------------------------------------------
i_ny_start    = input.int (930,  "NY session start (HHMM ET)", minval=0, maxval=2359, group="Window")
i_ny_end      = input.int (1545, "NY session end   (HHMM ET)", minval=0, maxval=2359, group="Window", tooltip="Last 15-min reference candle that can open a trade window. 1545 means the last trade window is 1545-1600.")
i_trade_ny    = input.bool(true, "Trade during NY session",    group="Window", tooltip="When ON: setups can arm/fire inside the NY-session window above.")
i_trade_nonNy = input.bool(false,"Trade outside NY session",   group="Window", tooltip="When ON: setups can arm/fire OUTSIDE the NY-session window above (London, Asia, Globex re-open, etc.). Independent of the NY toggle — turn both on for 24h coverage, both off for no trading.")

// ---- Inputs: setup detection ------------------------------------------------
i_sweep_buf_ticks  = input.int  (2,    "Sweep buffer (ticks beyond ref H/L)",   minval=1,  maxval=20, group="Setup",  tooltip="Price must wick at least this far beyond the magnet to count as a sweep. 2 ticks = 0.5 NQ pt.")
i_reclaim_bars     = input.int  (6,    "Bars allowed to reclaim after sweep",   minval=1,  maxval=20, group="Setup",  tooltip="6 bars on 30s = 3 minutes max for the reclaim to print.")
i_late_cutoff_min  = input.int  (3,    "Block new entries in last N min of window", minval=0, maxval=10, group="Setup")
i_min_ref_range    = input.float(8.0,  "Min reference candle range (pts)",      minval=0.0, maxval=100.0, step=0.5, group="Setup", tooltip="Skip windows whose 15m reference H-L is below this. Too-tight ranges produce flush-and-flush fakes.")
i_require_zone     = input.bool (true, "Require entry on the cheap side of midline", group="Setup", tooltip="LONG must enter below ref midline (we're buying weakness). SHORT must enter above. Filters out reclaims that already ran half the range.")

// ---- Inputs: exit math ------------------------------------------------------
i_target_pts       = input.float(12.0, "Target (points)",                       minval=1.0, maxval=50.0, step=0.25, group="Exit")
i_stop_max_pts     = input.float(10.0, "Stop cap (points)",                     minval=1.0, maxval=50.0, step=0.25, group="Exit", tooltip="Hard cap on stop distance. Wider natural stops cause the trade to be SKIPPED. Tightened from 14 to 10 in v1.2 — only take shallow-sweep setups where the reclaim is strongest.")
i_stop_extra_ticks = input.int  (1,    "Extra ticks beyond sweep extreme for stop", minval=0, maxval=20, group="Exit")
i_scale_enabled    = input.bool (false,"Scale: half at 1R, stop→BE, runner",    group="Exit")
i_runner_pts       = input.float(22.0, "Runner target (points)",                minval=1.0, maxval=80.0, step=0.5, group="Exit", tooltip="Used only when scale is on. After 1R partial + BE move, full target shifts here.")

// ---- Inputs: regime filter --------------------------------------------------
i_require_regime   = input.bool (true, "Require 15m 200MA regime alignment",    group="Regime", tooltip="When ON: longs only if close > 200MA(15m), shorts only if close < 200MA(15m). Filters trending-against days. Default ON in v1.2 — historical data shows +7-8pp lift.")
i_regime_len       = input.int  (200,  "Regime MA length (15m bars)",           minval=20, maxval=400, group="Regime")
i_vwap_band_pts    = input.float(5.0,  "VWAP confluence band (pts, badge only)", minval=0.0, maxval=50.0, step=0.5, group="Regime", tooltip="If entry is within this distance of session VWAP, a ★ badge is shown — confluence boost. Does not change entry logic.")

// ---- Inputs: display --------------------------------------------------------
i_show_refs        = input.bool (true, "Draw reference H/L extended lines",     group="Display")
i_show_mid         = input.bool (true, "Draw midline (dashed)",                 group="Display")
i_show_window_bg   = input.bool (true, "Shade NY trade-window background",      group="Display")
i_show_outcome     = input.bool (true, "Plot WIN/LOSS labels",                  group="Display")
i_show_stats       = input.bool (true, "Show rolling stats table",              group="Display")
i_show_setup_label = input.bool (true, "Show setup info label per window",      group="Display")
i_stats_pos        = input.string("top_right", "Stats table position", options=["top_left","top_center","top_right","middle_left","middle_right","bottom_left","bottom_center","bottom_right"], group="Display")

// ---- Inputs: colors ---------------------------------------------------------
i_col_ref     = input.color(color.aqua,             "Reference H/L lines", group="Style")
i_col_mid     = input.color(color.new(color.gray, 30), "Midline",         group="Style")
i_col_bg      = input.color(color.new(color.blue, 94),  "Window bg",      group="Style")
i_col_entry   = input.color(color.yellow,           "Entry",              group="Style")
i_col_stop    = input.color(color.red,              "Stop / LOSS",        group="Style")
i_col_target  = input.color(color.lime,             "Target / WIN",       group="Style")
i_col_long    = input.color(color.new(color.green, 0), "LONG label",      group="Style")
i_col_short   = input.color(color.new(color.red, 0),   "SHORT label",     group="Style")
i_col_swept   = input.color(color.new(color.orange, 20), "Sweep marker",  group="Style")
i_col_text    = input.color(color.white,            "Label text",         group="Style")
i_col_tbl_bg  = input.color(color.new(color.black, 60), "Table bg",       group="Style")

tz = "America/New_York"

// ---- HTF data (non-repainting) ---------------------------------------------
htf = "15"
[h15, l15, c15, t15] = request.security(syminfo.tickerid, htf, [high[1], low[1], close[1], time[1]], lookahead=barmerge.lookahead_on)
ma15  = request.security(syminfo.tickerid, htf, ta.sma(close, i_regime_len)[1], lookahead=barmerge.lookahead_on)
isNew15m = timeframe.change(htf)

vwapSess = ta.vwap(hlc3)

// ---- Time gating ------------------------------------------------------------
get_pos(string s) =>
    switch s
        "top_left" => position.top_left
        "top_center" => position.top_center
        "top_right" => position.top_right
        "middle_left" => position.middle_left
        "middle_right" => position.middle_right
        "bottom_left" => position.bottom_left
        "bottom_center" => position.bottom_center
        "bottom_right" => position.bottom_right
        => position.top_right

cur_hhmm() =>
    h = hour(time, tz)
    m = minute(time, tz)
    h * 100 + m

// Returns true when a bucket (HHMM) is allowed by the session toggles.
// NY-session check supports wrap-around (start > end) for sessions that span
// midnight, e.g. a 2000-0400 Asia window.
session_allowed(int bkt) =>
    bool in_ny = i_ny_start <= i_ny_end ? (bkt >= i_ny_start and bkt <= i_ny_end) : (bkt >= i_ny_start or bkt <= i_ny_end)
    (i_trade_ny and in_ny) or (i_trade_nonNy and not in_ny)

bkt_hhmm = cur_hhmm()

// ---- Per-window state -------------------------------------------------------
var float ref_h        = na
var float ref_l        = na
var float ref_mid      = na
var int   ref_bkt      = na
var int   win_start_bar = na
var int   win_end_bar   = na

var bool  win_armed    = false   // does the current window pass session + range gates? gates entries.
var bool  highTagged   = false
var bool  lowTagged    = false
var bool  lowSwept     = false
var bool  highSwept    = false
var float sweepLow     = na
var float sweepHigh    = na
var int   sweepBarIdx  = na

var bool  tradeTaken   = false
var bool  tradeActive  = false
var bool  partial_taken = false
var int   tradeSide    = 0
var float entryPx      = na
var float stopPx       = na
var float tgtPx        = na
var float r1Px         = na
var int   entryBar     = na

var line lnRefH = na
var line lnRefL = na
var line lnMid  = na
var line lnEntry = na
var line lnStop  = na
var line lnTgt   = na
var label setupLab = na

// ---- Stats ------------------------------------------------------------------
var int s_armed     = 0     // windows where ref range >= min
var int s_swept     = 0     // sweep events (count once per window per side)
var int s_filled    = 0     // entries fired
var int s_skipped_deep = 0  // setups rejected because sweep > stop_max
var int s_wins      = 0
var int s_partials  = 0
var int s_losses    = 0

// ---- Helpers ----------------------------------------------------------------
del_line(line l) =>
    if not na(l)
        line.delete(l)
del_label(label l) =>
    if not na(l)
        label.delete(l)

// =============================================================================
// Main loop
// =============================================================================
if barstate.isconfirmed
    // ---- New 15m reference candle close → reset window state ---------------
    if isNew15m
        // Finalize previous trade-by-window-end (if still active)
        if tradeActive
            float endPx = close[1]
            float diff = endPx - entryPx
            bool is_long = tradeSide > 0
            bool _win = partial_taken or (is_long ? diff > 0 : diff < 0)
            if _win
                s_wins += 1
                if i_show_outcome
                    label.new(bar_index - 1, endPx, "WIN +" + str.tostring(math.abs(diff), format.mintick), style=label.style_label_left, color=i_col_target, textcolor=color.black, size=size.tiny)
            else
                s_losses += 1
                if i_show_outcome
                    label.new(bar_index - 1, endPx, "LOSS -" + str.tostring(math.abs(diff), format.mintick), style=label.style_label_left, color=i_col_stop, textcolor=i_col_text, size=size.tiny)
            tradeActive := false

        // Clear visuals
        del_line(lnRefH)
        del_line(lnRefL)
        del_line(lnMid)
        del_line(lnEntry)
        del_line(lnStop)
        del_line(lnTgt)
        del_label(setupLab)

        // Capture new reference
        ref_h    := h15
        ref_l    := l15
        ref_mid  := (ref_h + ref_l) / 2.0
        ref_bkt  := hour(t15, tz) * 100 + minute(t15, tz)
        win_start_bar := bar_index
        win_end_bar   := bar_index + 30   // 30 bars of 30s = 15m

        // Reset setup state
        highTagged := false
        lowTagged  := false
        lowSwept   := false
        highSwept  := false
        sweepLow   := na
        sweepHigh  := na
        sweepBarIdx := na
        tradeTaken := false
        partial_taken := false
        tradeSide  := 0
        entryPx    := na
        stopPx     := na
        tgtPx      := na
        r1Px       := na
        entryBar   := na

        // Arm only if: session toggle allows the ref bucket AND ref range is wide enough
        bool ref_in_session = session_allowed(ref_bkt)
        bool range_ok = (ref_h - ref_l) >= i_min_ref_range
        bool armed = ref_in_session and range_ok
        win_armed := armed   // persists for the whole window — gates entry block below
        if armed
            s_armed += 1

        // Draw reference lines for armed windows
        if armed and i_show_refs
            lnRefH := line.new(bar_index, ref_h, win_end_bar, ref_h, color=i_col_ref, width=2)
            lnRefL := line.new(bar_index, ref_l, win_end_bar, ref_l, color=i_col_ref, width=2)
        if armed and i_show_mid
            lnMid := line.new(bar_index, ref_mid, win_end_bar, ref_mid, color=i_col_mid, style=line.style_dashed)
        if armed and i_show_setup_label
            string regime_txt = i_require_regime ? (close > ma15 ? "↑MA" : close < ma15 ? "↓MA" : "—MA") : "—"
            string lbl = "Bkt " + str.tostring(ref_bkt) + "  Rng " + str.tostring(ref_h - ref_l, "#.#") + "pt  " + regime_txt
            setupLab := label.new(bar_index, ref_h, lbl, style=label.style_label_lower_left, color=color.new(i_col_ref, 70), textcolor=i_col_text, size=size.small)

    // ---- Inside an active window: detect sweep, reclaim, manage trade ------
    else if not na(ref_h) and bar_index <= win_end_bar
        // Tag detection (informational — if extreme has already been tagged
        // cleanly without sweep, the sweep+reclaim setup on that side is dead)
        if high >= ref_h
            highTagged := true
        if low <= ref_l
            lowTagged := true

        // Sweep detection (with buffer)
        float buf = i_sweep_buf_ticks * syminfo.mintick
        if low <= ref_l - buf
            if not lowSwept
                lowSwept   := true
                sweepLow   := low
                sweepBarIdx := bar_index
                s_swept    += 1
            else
                sweepLow := math.min(sweepLow, low)
        if high >= ref_h + buf
            if not highSwept
                highSwept   := true
                sweepHigh   := high
                sweepBarIdx := bar_index
                s_swept    += 1
            else
                sweepHigh := math.max(sweepHigh, high)

        // Reclaim window
        int bars_since_sweep = na(sweepBarIdx) ? 999 : bar_index - sweepBarIdx
        bool within_reclaim = bars_since_sweep <= i_reclaim_bars

        // Reclaim condition: TWO consecutive 30s bars closed back inside the
        // reference range. v1.1 required only one — too noisy on 30s, generated
        // false reclaims that re-swept on the next bar. Two-bar persistence
        // gives up ~30s of move for a much stronger filter.
        bool reclaim_long  = lowSwept  and close > ref_l and close[1] > ref_l and within_reclaim
        bool reclaim_short = highSwept and close < ref_h and close[1] < ref_h and within_reclaim

        // Time cutoff: block entries in final N min of window
        int bars_left_in_window = win_end_bar - bar_index
        bool time_ok = bars_left_in_window >= (i_late_cutoff_min * 2)  // 2 bars per minute on 30s

        // Zone filter: long entries below midline, short entries above midline
        bool zone_ok_long  = not i_require_zone or close < ref_mid
        bool zone_ok_short = not i_require_zone or close > ref_mid

        // Regime filter
        bool regime_long_ok  = not i_require_regime or (not na(ma15) and close > ma15)
        bool regime_short_ok = not i_require_regime or (not na(ma15) and close < ma15)

        // CRITICAL gate (fixed in v1.2): entries must respect the session +
        // range arm filter. v1.1 fired trades 24h regardless of NY toggle.
        bool can_signal = win_armed and not tradeTaken and not tradeActive and time_ok

        bool buy_signal  = can_signal and reclaim_long  and not highTagged and zone_ok_long  and regime_long_ok
        bool sell_signal = can_signal and reclaim_short and not lowTagged  and zone_ok_short and regime_short_ok

        // ---- Entry ---------------------------------------------------------
        if buy_signal or sell_signal
            bool is_long = buy_signal
            float candidate_stop = is_long ? (sweepLow - i_stop_extra_ticks * syminfo.mintick) : (sweepHigh + i_stop_extra_ticks * syminfo.mintick)
            float stop_dist = math.abs(close - candidate_stop)
            // Reject trades whose natural stop is wider than the cap.
            // We trade only when structure permits a real ≤cap stop.
            if stop_dist > i_stop_max_pts
                s_skipped_deep += 1
                tradeTaken := true  // don't try again this window
                if i_show_outcome
                    label.new(bar_index, close, "SKIP deep sweep (" + str.tostring(stop_dist, "#.#") + "pt)", style=label.style_label_left, color=color.new(color.gray, 30), textcolor=i_col_text, size=size.tiny)
            else
                tradeTaken  := true
                tradeActive := true
                tradeSide   := is_long ? 1 : -1
                entryPx     := close
                entryBar    := bar_index
                stopPx      := candidate_stop
                float full_dist = i_scale_enabled ? i_runner_pts : i_target_pts
                tgtPx       := is_long ? (entryPx + full_dist) : (entryPx - full_dist)
                r1Px        := i_scale_enabled ? (is_long ? (entryPx + i_target_pts) : (entryPx - i_target_pts)) : na
                s_filled    += 1
                int x2 = win_end_bar
                lnEntry := line.new(bar_index, entryPx, x2, entryPx, color=i_col_entry, width=2)
                lnStop  := line.new(bar_index, stopPx,  x2, stopPx,  color=i_col_stop,  width=1, style=line.style_dashed)
                lnTgt   := line.new(bar_index, tgtPx,   x2, tgtPx,   color=i_col_target,width=1, style=line.style_dashed)
                bool vwap_conf = not na(vwapSess) and math.abs(entryPx - vwapSess) <= i_vwap_band_pts
                string side_txt = is_long ? "▲ LONG" : "▼ SHORT"
                string conf_txt = vwap_conf ? " ★VWAP" : ""
                label.new(bar_index, entryPx, side_txt + " @" + str.tostring(entryPx, format.mintick) + " stop " + str.tostring(stop_dist, "#.#") + "pt" + conf_txt, style=is_long ? label.style_label_up : label.style_label_down, color=is_long ? i_col_long : i_col_short, textcolor=i_col_text, size=size.small)

        // ---- Trade management ----------------------------------------------
        if tradeActive
            bool is_long = tradeSide > 0
            bool hit_stop   = is_long ? low  <= stopPx : high >= stopPx
            bool hit_target = is_long ? high >= tgtPx  : low  <= tgtPx
            bool hit_1r     = i_scale_enabled and not partial_taken and not na(r1Px) and (is_long ? high >= r1Px : low <= r1Px)

            // Partial at 1R first (if scale on and stop not yet hit on this bar)
            if hit_1r and not hit_stop
                partial_taken := true
                stopPx        := entryPx       // move to BE
                s_partials   += 1
                if i_show_outcome
                    label.new(bar_index, r1Px, "1R +" + str.tostring(i_target_pts, "#.#"), style=label.style_label_left, color=i_col_target, textcolor=color.black, size=size.tiny)

            if hit_stop
                tradeActive := false
                if partial_taken
                    s_wins += 1   // partial banked, runner BE → net +0.5R win
                    if i_show_outcome
                        label.new(bar_index, stopPx, "BE (+" + str.tostring(i_target_pts / 2.0, "#.#") + "R net)", style=label.style_label_left, color=i_col_target, textcolor=color.black, size=size.tiny)
                else
                    s_losses += 1
                    if i_show_outcome
                        label.new(bar_index, stopPx, "LOSS -" + str.tostring(math.abs(stopPx - entryPx), format.mintick), style=label.style_label_left, color=i_col_stop, textcolor=i_col_text, size=size.tiny)
            else if hit_target
                tradeActive := false
                s_wins += 1
                if i_show_outcome
                    label.new(bar_index, tgtPx, "WIN +" + str.tostring(math.abs(tgtPx - entryPx), format.mintick), style=label.style_label_left, color=i_col_target, textcolor=color.black, size=size.tiny)

        // ---- Sweep visual marker (once per side) ---------------------------
        // Marker placed at swept extreme on the sweep bar — visual only
        if lowSwept and bar_index == sweepBarIdx and not tradeTaken
            label.new(bar_index, sweepLow, "↓sw", style=label.style_label_up, color=i_col_swept, textcolor=color.black, size=size.tiny)
        if highSwept and bar_index == sweepBarIdx and not tradeTaken
            label.new(bar_index, sweepHigh, "↑sw", style=label.style_label_down, color=i_col_swept, textcolor=color.black, size=size.tiny)

// =============================================================================
// Window background shading
// =============================================================================
in_armed_window = not na(ref_h) and bar_index <= win_end_bar and (ref_h - ref_l) >= i_min_ref_range and session_allowed(ref_bkt)
bgcolor(i_show_window_bg and in_armed_window ? i_col_bg : na)

// =============================================================================
// Stats table
// =============================================================================
var table stbl = table.new(get_pos(i_stats_pos), columns=2, rows=10, bgcolor=i_col_tbl_bg, border_width=1)
if i_show_stats and barstate.islast
    table.set_position(stbl, get_pos(i_stats_pos))
    int decided = s_wins + s_losses
    float wr = decided > 0 ? (s_wins / float(decided)) * 100.0 : na
    string tgt_str = i_scale_enabled ? (str.tostring(i_target_pts, "#.#") + "→" + str.tostring(i_runner_pts, "#.#")) : str.tostring(i_target_pts, "#.#")
    table.cell(stbl, 0, 0, "Sweep+Reclaim", text_color=i_col_text, text_size=size.small)
    table.cell(stbl, 1, 0, "v1.2 NQ scalp", text_color=color.gray, text_size=size.small)
    table.cell(stbl, 0, 1, "tgt / cap",  text_color=i_col_text)
    table.cell(stbl, 1, 1, tgt_str + " / " + str.tostring(i_stop_max_pts, "#.#") + "pt", text_color=i_col_text)
    table.cell(stbl, 0, 2, "regime",     text_color=i_col_text)
    table.cell(stbl, 1, 2, i_require_regime ? "200MA on" : "off", text_color=i_col_text)
    table.cell(stbl, 0, 3, "armed wins", text_color=i_col_text)
    table.cell(stbl, 1, 3, str.tostring(s_armed),  text_color=i_col_text)
    table.cell(stbl, 0, 4, "sweeps",     text_color=i_col_text)
    table.cell(stbl, 1, 4, str.tostring(s_swept),  text_color=i_col_text)
    table.cell(stbl, 0, 5, "filled",     text_color=i_col_text)
    table.cell(stbl, 1, 5, str.tostring(s_filled), text_color=i_col_text)
    table.cell(stbl, 0, 6, "skip:deep",  text_color=color.gray)
    table.cell(stbl, 1, 6, str.tostring(s_skipped_deep), text_color=color.gray)
    table.cell(stbl, 0, 7, "wins",       text_color=i_col_target)
    table.cell(stbl, 1, 7, str.tostring(s_wins),   text_color=i_col_target)
    table.cell(stbl, 0, 8, "losses",     text_color=i_col_stop)
    table.cell(stbl, 1, 8, str.tostring(s_losses), text_color=i_col_stop)
    table.cell(stbl, 0, 9, "win%",       text_color=color.yellow)
    table.cell(stbl, 1, 9, na(wr) ? "—" : str.tostring(wr, "#.#") + "%", text_color=color.yellow)
