//@version=5
indicator("Lunch / Last Hour Structure", overlay=true, max_labels_count=50)

h = hour(time, "America/New_York")
m = minute(time, "America/New_York")
dow = dayofweek(time, "America/New_York")

// Capture RTH anchor levels
isOpen_930  = h == 9  and m == 30
is_1200     = h == 12 and m == 0
is_1400     = h == 14 and m == 0
is_1500     = h == 15 and m == 0
is_1545     = h == 15 and m == 45
is_1600     = h == 16 and m == 0  // close-of-RTH boundary; uses 15:45 candle's close

var float p930open  = na
var float p1200open = na
var float p1200close = na
var float p1400close = na
var float p1500open = na
var float p1500close = na
var float p1545open = na
var float rthHigh   = na
var float rthLow    = na
var float p1545range = na

// Update anchor levels through the day
if isOpen_930
    p930open := open
    rthHigh := high
    rthLow := low

if h >= 9 and h < 16
    if not na(rthHigh)
        rthHigh := math.max(rthHigh, high)
        rthLow := math.min(rthLow, low)

if is_1200
    p1200open := open
    p1200close := close[1]  // close of 11:45-12:00 candle on prior bar; close at this bar boundary

// Use close of bar at 11:45 for "12:00 reference" — i.e. the close of the 11:45-12:00 candle
// Actually since is_1200 fires at the 12:00 bar (12:00-12:15), `close[1]` is the prior bar's close which is the 11:45-12:00 close.
// That's exactly the "noon" reference.

if is_1400
    p1400close := close[1]  // close of 13:45-14:00 candle (the "2 PM" reference)

if is_1500
    p1500open := open
    p1500close := close[1]  // close of 14:45-15:00 candle

if is_1545
    p1545open := open
    p1545range := high - low

// At end-of-RTH (16:00 bar), evaluate the day
// 16:00 bar is 16:00-16:15; close[1] is 15:45-16:00 close (true RTH close)
var int n_days = 0
var int n_dow_mon = 0
var int n_dow_tue = 0
var int n_dow_wed = 0
var int n_dow_thu = 0
var int n_dow_fri = 0

// Morning bias: 12:00 close > 9:30 open ? green : red
// Lunch outcome: 14:00 close vs 12:00 close
// Last hour: 16:00 close vs 15:00 close
// Close auction: 15:45 candle range as % of RTH range

var int morn_green = 0
var int morn_red   = 0

// Lunch continuation/reversal of morning bias
var int lunch_cont_morn = 0  // morning green & lunch (14:00 > 12:00 close) green; or both red
var int lunch_rev_morn  = 0
var int lunch_flat = 0

// Last hour direction
var int lh_green = 0
var int lh_red   = 0
var int lh_flat  = 0

// Last hour direction by DOW (Mon-Fri = 2-6)
var int lh_g_mon = 0
var int lh_g_tue = 0
var int lh_g_wed = 0
var int lh_g_thu = 0
var int lh_g_fri = 0
var int lh_r_mon = 0
var int lh_r_tue = 0
var int lh_r_wed = 0
var int lh_r_thu = 0
var int lh_r_fri = 0

// Close-auction range stats
var float ca_range_sum = 0.0
var float rth_range_sum = 0.0
var int   ca_n = 0

if is_1600 and not na(p930open) and not na(p1200close) and not na(p1400close) and not na(p1500close) and not na(p1545open) and not na(rthHigh)
    closeRth = close[1]  // close at 16:00 bar uses 15:45-16:00 close
    rthRange = rthHigh - rthLow

    // Morning bias
    mornBias = p1200close > p930open ? 1 : p1200close < p930open ? -1 : 0
    if mornBias == 1
        morn_green += 1
    else if mornBias == -1
        morn_red += 1

    // Lunch outcome (14:00 close vs 12:00 close)
    lunchDir = p1400close > p1200close ? 1 : p1400close < p1200close ? -1 : 0
    if mornBias != 0 and lunchDir != 0
        if lunchDir == mornBias
            lunch_cont_morn += 1
        else
            lunch_rev_morn += 1
    if lunchDir == 0
        lunch_flat += 1

    // Last hour direction (16:00 close vs 15:00 close)
    lhDir = closeRth > p1500close ? 1 : closeRth < p1500close ? -1 : 0
    d = dow
    if lhDir == 1
        lh_green += 1
        if d == 2
            lh_g_mon += 1
        else if d == 3
            lh_g_tue += 1
        else if d == 4
            lh_g_wed += 1
        else if d == 5
            lh_g_thu += 1
        else if d == 6
            lh_g_fri += 1
    else if lhDir == -1
        lh_red += 1
        if d == 2
            lh_r_mon += 1
        else if d == 3
            lh_r_tue += 1
        else if d == 4
            lh_r_wed += 1
        else if d == 5
            lh_r_thu += 1
        else if d == 6
            lh_r_fri += 1
    else
        lh_flat += 1

    // DOW counters
    if d == 2
        n_dow_mon += 1
    else if d == 3
        n_dow_tue += 1
    else if d == 4
        n_dow_wed += 1
    else if d == 5
        n_dow_thu += 1
    else if d == 6
        n_dow_fri += 1

    // Close-auction range share (15:45 candle range / RTH range)
    if rthRange > 0 and not na(p1545range)
        ca_range_sum := ca_range_sum + p1545range
        rth_range_sum := rth_range_sum + rthRange
        ca_n += 1

    n_days += 1

f_pct(num, den) =>
    den > 0 ? num * 100.0 / den : 0.0

var table tbl = table.new(position.top_right, 5, 14, border_width=1)

if barstate.islast
    table.cell(tbl, 0, 0, "Stat",   bgcolor=color.navy, text_color=color.white)
    table.cell(tbl, 1, 0, "Count",  bgcolor=color.navy, text_color=color.white)
    table.cell(tbl, 2, 0, "Pct",    bgcolor=color.navy, text_color=color.white)
    table.cell(tbl, 3, 0, "Notes",  bgcolor=color.navy, text_color=color.white)
    table.cell(tbl, 4, 0, "n",      bgcolor=color.navy, text_color=color.white)

    table.cell(tbl, 0, 1, "Total days")
    table.cell(tbl, 1, 1, str.tostring(n_days))
    table.cell(tbl, 2, 1, "100")

    // Morning bias
    table.cell(tbl, 0, 2, "Morning bias green")
    table.cell(tbl, 1, 2, str.tostring(morn_green))
    table.cell(tbl, 2, 2, str.tostring(f_pct(morn_green, n_days), "#.##"))

    table.cell(tbl, 0, 3, "Morning bias red")
    table.cell(tbl, 1, 3, str.tostring(morn_red))
    table.cell(tbl, 2, 3, str.tostring(f_pct(morn_red, n_days), "#.##"))

    // Lunch outcome
    table.cell(tbl, 0, 4, "Lunch continues morning")
    table.cell(tbl, 1, 4, str.tostring(lunch_cont_morn))
    table.cell(tbl, 2, 4, str.tostring(f_pct(lunch_cont_morn, n_days), "#.##"))

    table.cell(tbl, 0, 5, "Lunch reverses morning")
    table.cell(tbl, 1, 5, str.tostring(lunch_rev_morn))
    table.cell(tbl, 2, 5, str.tostring(f_pct(lunch_rev_morn, n_days), "#.##"))

    // Last hour overall
    table.cell(tbl, 0, 6, "Last hour green")
    table.cell(tbl, 1, 6, str.tostring(lh_green))
    table.cell(tbl, 2, 6, str.tostring(f_pct(lh_green, n_days), "#.##"))

    table.cell(tbl, 0, 7, "Last hour red")
    table.cell(tbl, 1, 7, str.tostring(lh_red))
    table.cell(tbl, 2, 7, str.tostring(f_pct(lh_red, n_days), "#.##"))

    // Last hour by DOW
    table.cell(tbl, 0, 8, "Mon LH green%")
    table.cell(tbl, 1, 8, str.tostring(lh_g_mon))
    table.cell(tbl, 2, 8, str.tostring(f_pct(lh_g_mon, n_dow_mon), "#.##"))
    table.cell(tbl, 4, 8, str.tostring(n_dow_mon))

    table.cell(tbl, 0, 9, "Tue LH green%")
    table.cell(tbl, 1, 9, str.tostring(lh_g_tue))
    table.cell(tbl, 2, 9, str.tostring(f_pct(lh_g_tue, n_dow_tue), "#.##"))
    table.cell(tbl, 4, 9, str.tostring(n_dow_tue))

    table.cell(tbl, 0, 10, "Wed LH green%")
    table.cell(tbl, 1, 10, str.tostring(lh_g_wed))
    table.cell(tbl, 2, 10, str.tostring(f_pct(lh_g_wed, n_dow_wed), "#.##"))
    table.cell(tbl, 4, 10, str.tostring(n_dow_wed))

    table.cell(tbl, 0, 11, "Thu LH green%")
    table.cell(tbl, 1, 11, str.tostring(lh_g_thu))
    table.cell(tbl, 2, 11, str.tostring(f_pct(lh_g_thu, n_dow_thu), "#.##"))
    table.cell(tbl, 4, 11, str.tostring(n_dow_thu))

    table.cell(tbl, 0, 12, "Fri LH green%")
    table.cell(tbl, 1, 12, str.tostring(lh_g_fri))
    table.cell(tbl, 2, 12, str.tostring(f_pct(lh_g_fri, n_dow_fri), "#.##"))
    table.cell(tbl, 4, 12, str.tostring(n_dow_fri))

    // Close auction share
    caShare = ca_n > 0 and rth_range_sum > 0 ? ca_range_sum * 100.0 / rth_range_sum : 0
    table.cell(tbl, 0, 13, "Close-auc range %RTH")
    table.cell(tbl, 1, 13, str.tostring(ca_n))
    table.cell(tbl, 2, 13, str.tostring(caShare, "#.##"))
