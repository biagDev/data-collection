//@version=5
indicator("945 Hit Stats", overlay=true, max_labels_count=500)

h = hour(time, "America/New_York")
m = minute(time, "America/New_York")
dow = dayofweek(time, "America/New_York")

// Subject candle: 9:45-10:00 ET
isOpenBar  = h == 9  and m == 45
// Forward bars (after subject closes at 10:00)
isBar1015  = h == 10 and m == 15  // closes the 1st post-bar (10:00-10:15)
isBar1030  = h == 10 and m == 30  // closes the 2nd post-bar (10:15-10:30)
isBar1045  = h == 10 and m == 45  // closes the 3rd post-bar (10:30-10:45) — final tally here

var float openHigh = na
var float openLow  = na
var int   openDow  = na

// Cumulative hit flags per window
var bool hiHit1015 = false
var bool loHit1015 = false
var bool hiHit1030 = false
var bool loHit1030 = false
var bool hiHit1045 = false
var bool loHit1045 = false

// Aggregate counters per window
var int totalDays = 0

var int either1015 = 0
var int both1015 = 0
var int hiOnly1015 = 0
var int loOnly1015 = 0
var int neither1015 = 0
var int hiAny1015 = 0
var int loAny1015 = 0

var int either1030 = 0
var int both1030 = 0
var int hiOnly1030 = 0
var int loOnly1030 = 0
var int neither1030 = 0
var int hiAny1030 = 0
var int loAny1030 = 0

var int either1045 = 0
var int both1045 = 0
var int hiOnly1045 = 0
var int loOnly1045 = 0
var int neither1045 = 0
var int hiAny1045 = 0
var int loAny1045 = 0

// Per-DOW counters (idx 2=Mon..6=Fri)
var int[] dowDays      = array.new_int(8, 0)

var int[] dowEither15  = array.new_int(8, 0)
var int[] dowBoth15    = array.new_int(8, 0)
var int[] dowHiOnly15  = array.new_int(8, 0)
var int[] dowLoOnly15  = array.new_int(8, 0)
var int[] dowNeither15 = array.new_int(8, 0)

var int[] dowEither30  = array.new_int(8, 0)
var int[] dowBoth30    = array.new_int(8, 0)
var int[] dowHiOnly30  = array.new_int(8, 0)
var int[] dowLoOnly30  = array.new_int(8, 0)
var int[] dowNeither30 = array.new_int(8, 0)

var int[] dowEither45  = array.new_int(8, 0)
var int[] dowBoth45    = array.new_int(8, 0)
var int[] dowHiOnly45  = array.new_int(8, 0)
var int[] dowLoOnly45  = array.new_int(8, 0)
var int[] dowNeither45 = array.new_int(8, 0)

if isOpenBar
    openHigh := high
    openLow  := low
    openDow  := dow
    hiHit1015 := false
    loHit1015 := false
    hiHit1030 := false
    loHit1030 := false
    hiHit1045 := false
    loHit1045 := false

// 10:00-10:15 candle
if isBar1015 and not na(openHigh)
    if high >= openHigh
        hiHit1015 := true
        hiHit1030 := true
        hiHit1045 := true
    if low <= openLow
        loHit1015 := true
        loHit1030 := true
        loHit1045 := true

// 10:15-10:30 candle
if isBar1030 and not na(openHigh)
    if high >= openHigh
        hiHit1030 := true
        hiHit1045 := true
    if low <= openLow
        loHit1030 := true
        loHit1045 := true

// 10:30-10:45 candle: final tally
if isBar1045 and not na(openHigh)
    if high >= openHigh
        hiHit1045 := true
    if low <= openLow
        loHit1045 := true

    totalDays += 1

    // 10:15 window
    if hiHit1015
        hiAny1015 += 1
    if loHit1015
        loAny1015 += 1
    if hiHit1015 and loHit1015
        both1015 += 1
        either1015 += 1
    else if hiHit1015
        hiOnly1015 += 1
        either1015 += 1
    else if loHit1015
        loOnly1015 += 1
        either1015 += 1
    else
        neither1015 += 1

    // 10:30 window
    if hiHit1030
        hiAny1030 += 1
    if loHit1030
        loAny1030 += 1
    if hiHit1030 and loHit1030
        both1030 += 1
        either1030 += 1
    else if hiHit1030
        hiOnly1030 += 1
        either1030 += 1
    else if loHit1030
        loOnly1030 += 1
        either1030 += 1
    else
        neither1030 += 1

    // 10:45 window
    if hiHit1045
        hiAny1045 += 1
    if loHit1045
        loAny1045 += 1
    if hiHit1045 and loHit1045
        both1045 += 1
        either1045 += 1
    else if hiHit1045
        hiOnly1045 += 1
        either1045 += 1
    else if loHit1045
        loOnly1045 += 1
        either1045 += 1
    else
        neither1045 += 1

    // DOW
    d = openDow
    if d >= 2 and d <= 6
        array.set(dowDays, d, array.get(dowDays, d) + 1)

        if hiHit1015 and loHit1015
            array.set(dowBoth15,   d, array.get(dowBoth15,   d) + 1)
            array.set(dowEither15, d, array.get(dowEither15, d) + 1)
        else if hiHit1015
            array.set(dowHiOnly15, d, array.get(dowHiOnly15, d) + 1)
            array.set(dowEither15, d, array.get(dowEither15, d) + 1)
        else if loHit1015
            array.set(dowLoOnly15, d, array.get(dowLoOnly15, d) + 1)
            array.set(dowEither15, d, array.get(dowEither15, d) + 1)
        else
            array.set(dowNeither15, d, array.get(dowNeither15, d) + 1)

        if hiHit1030 and loHit1030
            array.set(dowBoth30,   d, array.get(dowBoth30,   d) + 1)
            array.set(dowEither30, d, array.get(dowEither30, d) + 1)
        else if hiHit1030
            array.set(dowHiOnly30, d, array.get(dowHiOnly30, d) + 1)
            array.set(dowEither30, d, array.get(dowEither30, d) + 1)
        else if loHit1030
            array.set(dowLoOnly30, d, array.get(dowLoOnly30, d) + 1)
            array.set(dowEither30, d, array.get(dowEither30, d) + 1)
        else
            array.set(dowNeither30, d, array.get(dowNeither30, d) + 1)

        if hiHit1045 and loHit1045
            array.set(dowBoth45,   d, array.get(dowBoth45,   d) + 1)
            array.set(dowEither45, d, array.get(dowEither45, d) + 1)
        else if hiHit1045
            array.set(dowHiOnly45, d, array.get(dowHiOnly45, d) + 1)
            array.set(dowEither45, d, array.get(dowEither45, d) + 1)
        else if loHit1045
            array.set(dowLoOnly45, d, array.get(dowLoOnly45, d) + 1)
            array.set(dowEither45, d, array.get(dowEither45, d) + 1)
        else
            array.set(dowNeither45, d, array.get(dowNeither45, d) + 1)

f_pct(num, den) =>
    den > 0 ? num * 100.0 / den : 0.0

var table tAgg = table.new(position.top_right, 7, 10, border_width=1)
var table tDow = table.new(position.middle_right, 17, 7, border_width=1)

if barstate.islast
    table.cell(tAgg, 0, 0, "Aggregate",  bgcolor=color.navy, text_color=color.white)
    table.cell(tAgg, 1, 0, "10:15 #",    bgcolor=color.navy, text_color=color.white)
    table.cell(tAgg, 2, 0, "10:15 %",    bgcolor=color.navy, text_color=color.white)
    table.cell(tAgg, 3, 0, "10:30 #",    bgcolor=color.navy, text_color=color.white)
    table.cell(tAgg, 4, 0, "10:30 %",    bgcolor=color.navy, text_color=color.white)
    table.cell(tAgg, 5, 0, "10:45 #",    bgcolor=color.navy, text_color=color.white)
    table.cell(tAgg, 6, 0, "10:45 %",    bgcolor=color.navy, text_color=color.white)

    table.cell(tAgg, 0, 1, "Total days")
    table.cell(tAgg, 1, 1, str.tostring(totalDays))
    table.cell(tAgg, 2, 1, "100")
    table.cell(tAgg, 3, 1, str.tostring(totalDays))
    table.cell(tAgg, 4, 1, "100")
    table.cell(tAgg, 5, 1, str.tostring(totalDays))
    table.cell(tAgg, 6, 1, "100")

    table.cell(tAgg, 0, 2, "Either side")
    table.cell(tAgg, 1, 2, str.tostring(either1015))
    table.cell(tAgg, 2, 2, str.tostring(f_pct(either1015, totalDays), "#.##"))
    table.cell(tAgg, 3, 2, str.tostring(either1030))
    table.cell(tAgg, 4, 2, str.tostring(f_pct(either1030, totalDays), "#.##"))
    table.cell(tAgg, 5, 2, str.tostring(either1045))
    table.cell(tAgg, 6, 2, str.tostring(f_pct(either1045, totalDays), "#.##"))

    table.cell(tAgg, 0, 3, "Both sides")
    table.cell(tAgg, 1, 3, str.tostring(both1015))
    table.cell(tAgg, 2, 3, str.tostring(f_pct(both1015, totalDays), "#.##"))
    table.cell(tAgg, 3, 3, str.tostring(both1030))
    table.cell(tAgg, 4, 3, str.tostring(f_pct(both1030, totalDays), "#.##"))
    table.cell(tAgg, 5, 3, str.tostring(both1045))
    table.cell(tAgg, 6, 3, str.tostring(f_pct(both1045, totalDays), "#.##"))

    table.cell(tAgg, 0, 4, "High only")
    table.cell(tAgg, 1, 4, str.tostring(hiOnly1015))
    table.cell(tAgg, 2, 4, str.tostring(f_pct(hiOnly1015, totalDays), "#.##"))
    table.cell(tAgg, 3, 4, str.tostring(hiOnly1030))
    table.cell(tAgg, 4, 4, str.tostring(f_pct(hiOnly1030, totalDays), "#.##"))
    table.cell(tAgg, 5, 4, str.tostring(hiOnly1045))
    table.cell(tAgg, 6, 4, str.tostring(f_pct(hiOnly1045, totalDays), "#.##"))

    table.cell(tAgg, 0, 5, "Low only")
    table.cell(tAgg, 1, 5, str.tostring(loOnly1015))
    table.cell(tAgg, 2, 5, str.tostring(f_pct(loOnly1015, totalDays), "#.##"))
    table.cell(tAgg, 3, 5, str.tostring(loOnly1030))
    table.cell(tAgg, 4, 5, str.tostring(f_pct(loOnly1030, totalDays), "#.##"))
    table.cell(tAgg, 5, 5, str.tostring(loOnly1045))
    table.cell(tAgg, 6, 5, str.tostring(f_pct(loOnly1045, totalDays), "#.##"))

    table.cell(tAgg, 0, 6, "Neither")
    table.cell(tAgg, 1, 6, str.tostring(neither1015))
    table.cell(tAgg, 2, 6, str.tostring(f_pct(neither1015, totalDays), "#.##"))
    table.cell(tAgg, 3, 6, str.tostring(neither1030))
    table.cell(tAgg, 4, 6, str.tostring(f_pct(neither1030, totalDays), "#.##"))
    table.cell(tAgg, 5, 6, str.tostring(neither1045))
    table.cell(tAgg, 6, 6, str.tostring(f_pct(neither1045, totalDays), "#.##"))

    table.cell(tAgg, 0, 7, "High touched (any)")
    table.cell(tAgg, 1, 7, str.tostring(hiAny1015))
    table.cell(tAgg, 2, 7, str.tostring(f_pct(hiAny1015, totalDays), "#.##"))
    table.cell(tAgg, 3, 7, str.tostring(hiAny1030))
    table.cell(tAgg, 4, 7, str.tostring(f_pct(hiAny1030, totalDays), "#.##"))
    table.cell(tAgg, 5, 7, str.tostring(hiAny1045))
    table.cell(tAgg, 6, 7, str.tostring(f_pct(hiAny1045, totalDays), "#.##"))

    table.cell(tAgg, 0, 8, "Low touched (any)")
    table.cell(tAgg, 1, 8, str.tostring(loAny1015))
    table.cell(tAgg, 2, 8, str.tostring(f_pct(loAny1015, totalDays), "#.##"))
    table.cell(tAgg, 3, 8, str.tostring(loAny1030))
    table.cell(tAgg, 4, 8, str.tostring(f_pct(loAny1030, totalDays), "#.##"))
    table.cell(tAgg, 5, 8, str.tostring(loAny1045))
    table.cell(tAgg, 6, 8, str.tostring(f_pct(loAny1045, totalDays), "#.##"))

    headers = array.from("DOW", "N", "Eit15%", "Bth15%", "Hi15", "Lo15", "Nei15", "Eit30%", "Bth30%", "Hi30", "Lo30", "Nei30", "Eit45%", "Bth45%", "Hi45", "Lo45", "Nei45")
    for i = 0 to 16
        table.cell(tDow, i, 0, array.get(headers, i), bgcolor=color.navy, text_color=color.white)
    dowNames = array.from("", "", "Mon", "Tue", "Wed", "Thu", "Fri")
    for d = 2 to 6
        n = array.get(dowDays, d)
        row = d - 1
        table.cell(tDow, 0,  row, array.get(dowNames, d))
        table.cell(tDow, 1,  row, str.tostring(n))
        table.cell(tDow, 2,  row, str.tostring(f_pct(array.get(dowEither15, d), n), "#.##"))
        table.cell(tDow, 3,  row, str.tostring(f_pct(array.get(dowBoth15,   d), n), "#.##"))
        table.cell(tDow, 4,  row, str.tostring(array.get(dowHiOnly15, d)))
        table.cell(tDow, 5,  row, str.tostring(array.get(dowLoOnly15, d)))
        table.cell(tDow, 6,  row, str.tostring(array.get(dowNeither15, d)))
        table.cell(tDow, 7,  row, str.tostring(f_pct(array.get(dowEither30, d), n), "#.##"))
        table.cell(tDow, 8,  row, str.tostring(f_pct(array.get(dowBoth30,   d), n), "#.##"))
        table.cell(tDow, 9,  row, str.tostring(array.get(dowHiOnly30, d)))
        table.cell(tDow, 10, row, str.tostring(array.get(dowLoOnly30, d)))
        table.cell(tDow, 11, row, str.tostring(array.get(dowNeither30, d)))
        table.cell(tDow, 12, row, str.tostring(f_pct(array.get(dowEither45, d), n), "#.##"))
        table.cell(tDow, 13, row, str.tostring(f_pct(array.get(dowBoth45,   d), n), "#.##"))
        table.cell(tDow, 14, row, str.tostring(array.get(dowHiOnly45, d)))
        table.cell(tDow, 15, row, str.tostring(array.get(dowLoOnly45, d)))
        table.cell(tDow, 16, row, str.tostring(array.get(dowNeither45, d)))
