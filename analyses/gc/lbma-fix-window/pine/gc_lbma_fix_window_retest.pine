//@version=5
indicator("GC LBMA AM Fix Retest", overlay=true, max_labels_count=50)

h = hour(time, "America/New_York")
m = minute(time, "America/New_York")
dow = dayofweek(time, "America/New_York")

// Subject candle hour/minute pairs (6 candles, sequential 15m)
isSubj0 = h == 5 and m == 0
isSubj1 = h == 5 and m == 15
isSubj2 = h == 5 and m == 30
isSubj3 = h == 5 and m == 45
isSubj4 = h == 6 and m == 0
isSubj5 = h == 6 and m == 15
isP1_0 = h == 5 and m == 15
isP2_0 = h == 5 and m == 30
isP3_0 = h == 5 and m == 45
isP1_1 = h == 5 and m == 30
isP2_1 = h == 5 and m == 45
isP3_1 = h == 6 and m == 0
isP1_2 = h == 5 and m == 45
isP2_2 = h == 6 and m == 0
isP3_2 = h == 6 and m == 15
isP1_3 = h == 6 and m == 0
isP2_3 = h == 6 and m == 15
isP3_3 = h == 6 and m == 30
isP1_4 = h == 6 and m == 15
isP2_4 = h == 6 and m == 30
isP3_4 = h == 6 and m == 45
isP1_5 = h == 6 and m == 30
isP2_5 = h == 6 and m == 45
isP3_5 = h == 7 and m == 0

