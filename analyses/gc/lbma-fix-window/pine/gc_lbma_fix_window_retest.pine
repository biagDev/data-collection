f_pct(num, den) =>
    den > 0 ? num * 100.0 / den : 0.0

var table tbl = table.new(position.top_right, 11, 8, border_width=1)

if barstate.islast
    table.cell(tbl, 0, 0, "Candle ET", bgcolor=color.navy, text_color=color.white)
    table.cell(tbl, 1, 0, "n",       bgcolor=color.navy, text_color=color.white)
