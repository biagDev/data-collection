if isSubj0
    oh_0 := high
    ol_0 := low
    hh1_0 := false
    ll1_0 := false
    hh2_0 := false
    ll2_0 := false
    hh3_0 := false
    ll3_0 := false

if isP1_0 and not na(oh_0)
    if high >= oh_0
        hh1_0 := true
        hh2_0 := true
        hh3_0 := true
    if low <= ol_0
        ll1_0 := true
        ll2_0 := true
        ll3_0 := true

if isP2_0 and not na(oh_0)
    if high >= oh_0
        hh2_0 := true
        hh3_0 := true
    if low <= ol_0
        ll2_0 := true
        ll3_0 := true

if isP3_0 and not na(oh_0)
    if high >= oh_0
        hh3_0 := true
    if low <= ol_0
        ll3_0 := true

    n_0 += 1
    if hh1_0 or ll1_0
        e1_0 += 1
    if hh2_0 or ll2_0
        e2_0 += 1
    if hh3_0 or ll3_0
        e3_0 += 1
    if hh1_0 and ll1_0
        b1_0 += 1
    if hh2_0 and ll2_0
        b2_0 += 1
    if hh3_0 and ll3_0
        b3_0 += 1
    if hh3_0
        ha3_0 += 1
    if ll3_0
        la3_0 += 1
    if not hh3_0 and not ll3_0
        none3_0 += 1


