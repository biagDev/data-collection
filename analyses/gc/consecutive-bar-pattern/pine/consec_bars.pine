//@version=5
indicator("Consecutive Bar Pattern", overlay=true, max_labels_count=50)

// Track consecutive same-color streaks on the current chart timeframe (15m).
// For each ending streak length (1..5+), measure P(next bar continues) vs P(reverses).
// Restricted to RTH on equity-index futures? No - run on all bars (24h applies for FX/futures).
// Excludes overnight gap-bar artifacts by skipping bars at known maintenance windows.

isGreen = close > open
isRed   = close < open
// Doji bars (close == open) skipped from streak

var int streak = 0
var int lastColor = 0  // 1=green, -1=red, 0=none

// Counters: bins for streak lengths 1..5+, with continuation/reversal outcomes
var int n_1 = 0
var int n_2 = 0
var int n_3 = 0
var int n_4 = 0
var int n_5 = 0  // 5+

var int cont_1 = 0  // streak of 1 → next-bar same color
var int cont_2 = 0
var int cont_3 = 0
var int cont_4 = 0
var int cont_5 = 0

var int rev_1 = 0   // streak of N → next-bar opposite color
var int rev_2 = 0
var int rev_3 = 0
var int rev_4 = 0
var int rev_5 = 0

// At each bar close, evaluate the previous bar's streak and current bar's outcome
// streak counts the run ending on the PRIOR bar; this bar is the "next bar" outcome.

// Compute prior bar's color from one-bar lookback
priorColor = nz(close[1]) > nz(open[1]) ? 1 : nz(close[1]) < nz(open[1]) ? -1 : 0
thisColor  = isGreen ? 1 : isRed ? -1 : 0

// Update streak counter using prior bar
var int prevStreak = 0
prevStreak := streak

if priorColor != 0
    if priorColor == lastColor
        streak := streak + 1
    else
        streak := 1
    lastColor := priorColor

// Now categorize the *prior* streak's outcome against thisColor
// Only count bars where both prior was non-doji AND this is non-doji
if priorColor != 0 and thisColor != 0 and bar_index > 5
    sl = math.min(prevStreak, 5)
    isContinuation = thisColor == priorColor

    if sl == 1
        n_1 += 1
        if isContinuation
            cont_1 += 1
        else
            rev_1 += 1
    else if sl == 2
        n_2 += 1
        if isContinuation
            cont_2 += 1
        else
            rev_2 += 1
    else if sl == 3
        n_3 += 1
        if isContinuation
            cont_3 += 1
        else
            rev_3 += 1
    else if sl == 4
        n_4 += 1
        if isContinuation
            cont_4 += 1
        else
            rev_4 += 1
    else if sl >= 5
        n_5 += 1
        if isContinuation
            cont_5 += 1
        else
            rev_5 += 1

f_pct(num, den) =>
    den > 0 ? num * 100.0 / den : 0.0

var table tbl = table.new(position.top_right, 5, 8, border_width=1)

if barstate.islast
    table.cell(tbl, 0, 0, "Streak",   bgcolor=color.navy, text_color=color.white)
    table.cell(tbl, 1, 0, "Count n",  bgcolor=color.navy, text_color=color.white)
    table.cell(tbl, 2, 0, "Continue%",bgcolor=color.navy, text_color=color.white)
    table.cell(tbl, 3, 0, "Reverse%", bgcolor=color.navy, text_color=color.white)
    table.cell(tbl, 4, 0, "ContN/RevN",bgcolor=color.navy, text_color=color.white)

    table.cell(tbl, 0, 1, "1 bar")
    table.cell(tbl, 1, 1, str.tostring(n_1))
    table.cell(tbl, 2, 1, str.tostring(f_pct(cont_1, n_1), "#.##"))
    table.cell(tbl, 3, 1, str.tostring(f_pct(rev_1, n_1), "#.##"))
    table.cell(tbl, 4, 1, str.tostring(cont_1) + "/" + str.tostring(rev_1))

    table.cell(tbl, 0, 2, "2 bars")
    table.cell(tbl, 1, 2, str.tostring(n_2))
    table.cell(tbl, 2, 2, str.tostring(f_pct(cont_2, n_2), "#.##"))
    table.cell(tbl, 3, 2, str.tostring(f_pct(rev_2, n_2), "#.##"))
    table.cell(tbl, 4, 2, str.tostring(cont_2) + "/" + str.tostring(rev_2))

    table.cell(tbl, 0, 3, "3 bars")
    table.cell(tbl, 1, 3, str.tostring(n_3))
    table.cell(tbl, 2, 3, str.tostring(f_pct(cont_3, n_3), "#.##"))
    table.cell(tbl, 3, 3, str.tostring(f_pct(rev_3, n_3), "#.##"))
    table.cell(tbl, 4, 3, str.tostring(cont_3) + "/" + str.tostring(rev_3))

    table.cell(tbl, 0, 4, "4 bars")
    table.cell(tbl, 1, 4, str.tostring(n_4))
    table.cell(tbl, 2, 4, str.tostring(f_pct(cont_4, n_4), "#.##"))
    table.cell(tbl, 3, 4, str.tostring(f_pct(rev_4, n_4), "#.##"))
    table.cell(tbl, 4, 4, str.tostring(cont_4) + "/" + str.tostring(rev_4))

    table.cell(tbl, 0, 5, "5+ bars")
    table.cell(tbl, 1, 5, str.tostring(n_5))
    table.cell(tbl, 2, 5, str.tostring(f_pct(cont_5, n_5), "#.##"))
    table.cell(tbl, 3, 5, str.tostring(f_pct(rev_5, n_5), "#.##"))
    table.cell(tbl, 4, 5, str.tostring(cont_5) + "/" + str.tostring(rev_5))

    total = n_1 + n_2 + n_3 + n_4 + n_5
    totalCont = cont_1 + cont_2 + cont_3 + cont_4 + cont_5
    table.cell(tbl, 0, 6, "Total")
    table.cell(tbl, 1, 6, str.tostring(total))
    table.cell(tbl, 2, 6, str.tostring(f_pct(totalCont, total), "#.##"))
    table.cell(tbl, 3, 6, str.tostring(f_pct(total - totalCont, total), "#.##"))
    table.cell(tbl, 4, 6, str.tostring(totalCont) + "/" + str.tostring(total - totalCont))
