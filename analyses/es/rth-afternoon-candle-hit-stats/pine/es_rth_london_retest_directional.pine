//@version=5
// ============================================================================
// ES RTH+London Retest — Directional (single-pass collector)
//
// Captures the per-side breakdown (hi_only / lo_only / hi_any / lo_any / both)
// for 14 ES 15m subject candles that were previously missing from the
// directional analysis:
//   - London open killzone : 3:00, 3:15, 3:30, 3:45, 4:00, 4:15 AM ET
//   - RTH afternoon        : 11:00, 11:30, 12:00, 12:30, 1:00, 2:00, 3:00, 3:45 PM ET
//
// Produced the data in:
//   - analyses/es/london-candle-hit-stats/data/results.json (overwritten v2026-05-17)
//   - analyses/es/rth-afternoon-candle-hit-stats/data/results.json (new)
//
// HOW TO RUN
//   - Set chart symbol to CME_MINI:ES1!
//   - Set chart timeframe to 15 minutes
//   - Apply this indicator
//   - Load as much history as TV will give you (scroll back)
//   - Read the table via data_get_pine_tables, split into London + RTH afternoon
//     rows in their respective results.json files.
// ============================================================================
indicator("ES RTH+London Retest — Directional", overlay=true, max_labels_count=50)

i_show = input.bool(true, "Show stats table")

h = hour(time, "America/New_York")
m = minute(time, "America/New_York")
clockTime = h * 100 + m

// 14 subject candles: London (3:00-4:15 AM) + RTH afternoon (11:00 AM - 3:45 PM)
times  = array.from(300, 315, 330, 345, 400, 415, 1100, 1130, 1200, 1230, 1300, 1400, 1500, 1545)
labels = array.from("3:00 AM", "3:15 AM", "3:30 AM", "3:45 AM", "4:00 AM", "4:15 AM", "11:00 AM", "11:30 AM", "12:00 PM", "12:30 PM", "1:00 PM", "2:00 PM", "3:00 PM", "3:45 PM")

var array<float> subjH       = array.new<float>(14, na)
var array<float> subjL       = array.new<float>(14, na)
var array<int>   barsForward = array.new<int>(14, 0)
var array<bool>  hitH_15     = array.new<bool>(14, false)
var array<bool>  hitL_15     = array.new<bool>(14, false)
var array<bool>  hitH_30     = array.new<bool>(14, false)
var array<bool>  hitL_30     = array.new<bool>(14, false)
var array<bool>  hitH_45     = array.new<bool>(14, false)
var array<bool>  hitL_45     = array.new<bool>(14, false)

var array<int> n_total = array.new<int>(14, 0)
var array<int> ho_15 = array.new<int>(14, 0)
var array<int> lo_15 = array.new<int>(14, 0)
var array<int> b_15  = array.new<int>(14, 0)
var array<int> ho_30 = array.new<int>(14, 0)
var array<int> lo_30 = array.new<int>(14, 0)
var array<int> b_30  = array.new<int>(14, 0)
var array<int> ho_45 = array.new<int>(14, 0)
var array<int> lo_45 = array.new<int>(14, 0)
var array<int> b_45  = array.new<int>(14, 0)

if barstate.isconfirmed
    for i = 0 to 13
        int subjTime = array.get(times, i)
        if clockTime == subjTime
            array.set(subjH, i, high)
            array.set(subjL, i, low)
            array.set(barsForward, i, 0)
            array.set(hitH_15, i, false)
            array.set(hitL_15, i, false)
            array.set(hitH_30, i, false)
            array.set(hitL_30, i, false)
            array.set(hitH_45, i, false)
            array.set(hitL_45, i, false)
        else if not na(array.get(subjH, i))
            int bf = array.get(barsForward, i) + 1
            array.set(barsForward, i, bf)
            float sH = array.get(subjH, i)
            float sL = array.get(subjL, i)
            bool hH = high >= sH
            bool hL = low  <= sL
            if bf == 1
                array.set(hitH_15, i, hH)
                array.set(hitL_15, i, hL)
                array.set(hitH_30, i, hH)
                array.set(hitL_30, i, hL)
                array.set(hitH_45, i, hH)
                array.set(hitL_45, i, hL)
            if bf == 2
                array.set(hitH_30, i, array.get(hitH_30, i) or hH)
                array.set(hitL_30, i, array.get(hitL_30, i) or hL)
                array.set(hitH_45, i, array.get(hitH_45, i) or hH)
                array.set(hitL_45, i, array.get(hitL_45, i) or hL)
            if bf == 3
                array.set(hitH_45, i, array.get(hitH_45, i) or hH)
                array.set(hitL_45, i, array.get(hitL_45, i) or hL)
                array.set(n_total, i, array.get(n_total, i) + 1)
                bool h15 = array.get(hitH_15, i)
                bool l15 = array.get(hitL_15, i)
                bool h30 = array.get(hitH_30, i)
                bool l30 = array.get(hitL_30, i)
                bool h45 = array.get(hitH_45, i)
                bool l45 = array.get(hitL_45, i)
                if h15 and not l15
                    array.set(ho_15, i, array.get(ho_15, i) + 1)
                if l15 and not h15
                    array.set(lo_15, i, array.get(lo_15, i) + 1)
                if h15 and l15
                    array.set(b_15, i, array.get(b_15, i) + 1)
                if h30 and not l30
                    array.set(ho_30, i, array.get(ho_30, i) + 1)
                if l30 and not h30
                    array.set(lo_30, i, array.get(lo_30, i) + 1)
                if h30 and l30
                    array.set(b_30, i, array.get(b_30, i) + 1)
                if h45 and not l45
                    array.set(ho_45, i, array.get(ho_45, i) + 1)
                if l45 and not h45
                    array.set(lo_45, i, array.get(lo_45, i) + 1)
                if h45 and l45
                    array.set(b_45, i, array.get(b_45, i) + 1)
                array.set(subjH, i, na)
                array.set(subjL, i, na)

var table tbl = table.new(position.top_right, columns=11, rows=16, bgcolor=color.new(color.black, 70), border_width=1)
if i_show and barstate.islast
    table.cell(tbl, 0,  0, "candle",     text_color=color.white)
    table.cell(tbl, 1,  0, "n",          text_color=color.white)
    table.cell(tbl, 2,  0, "hi_only_15", text_color=color.white)
    table.cell(tbl, 3,  0, "lo_only_15", text_color=color.white)
    table.cell(tbl, 4,  0, "both_15",    text_color=color.white)
    table.cell(tbl, 5,  0, "hi_any_15",  text_color=color.white)
    table.cell(tbl, 6,  0, "lo_any_15",  text_color=color.white)
    table.cell(tbl, 7,  0, "hi_any_30",  text_color=color.white)
    table.cell(tbl, 8,  0, "lo_any_30",  text_color=color.white)
    table.cell(tbl, 9,  0, "hi_any_45",  text_color=color.white)
    table.cell(tbl, 10, 0, "lo_any_45",  text_color=color.white)
    for i = 0 to 13
        int r = i + 1
        int n = array.get(n_total, i)
        if n > 0
            float nf = float(n)
            float h15 = array.get(ho_15, i)
            float l15 = array.get(lo_15, i)
            float b15 = array.get(b_15, i)
            float h30 = array.get(ho_30, i)
            float l30 = array.get(lo_30, i)
            float b30 = array.get(b_30, i)
            float h45 = array.get(ho_45, i)
            float l45 = array.get(lo_45, i)
            float b45 = array.get(b_45, i)
            table.cell(tbl, 0,  r, array.get(labels, i), text_color=color.white)
            table.cell(tbl, 1,  r, str.tostring(n), text_color=color.white)
            table.cell(tbl, 2,  r, str.tostring(h15  / nf * 100, "#.##"), text_color=color.white)
            table.cell(tbl, 3,  r, str.tostring(l15  / nf * 100, "#.##"), text_color=color.white)
            table.cell(tbl, 4,  r, str.tostring(b15  / nf * 100, "#.##"), text_color=color.white)
            table.cell(tbl, 5,  r, str.tostring((h15 + b15) / nf * 100, "#.##"), text_color=color.white)
            table.cell(tbl, 6,  r, str.tostring((l15 + b15) / nf * 100, "#.##"), text_color=color.white)
            table.cell(tbl, 7,  r, str.tostring((h30 + b30) / nf * 100, "#.##"), text_color=color.white)
            table.cell(tbl, 8,  r, str.tostring((l30 + b30) / nf * 100, "#.##"), text_color=color.white)
            table.cell(tbl, 9,  r, str.tostring((h45 + b45) / nf * 100, "#.##"), text_color=color.white)
            table.cell(tbl, 10, r, str.tostring((l45 + b45) / nf * 100, "#.##"), text_color=color.white)
