//@version=5
indicator("03 Max Excursion", overlay=true)

h = hour(time, "America/New_York")
m = minute(time, "America/New_York")

isOpenBar = h == 9 and m == 30
isAfter = (h == 9 and m == 45) or (h == 10) or (h == 11) or (h == 12) or (h == 13) or (h == 14) or (h == 15)

var float oh = na
var float ol = na
var float orange = na
var bool hitEither = false
var float maxExcursionUp = 0.0
var float maxExcursionDown = 0.0

var int totalDays = 0
var int hitDays = 0
var float sumExcAsPctRange = 0.0
var int days_exc_le_25 = 0
var int days_exc_25_50 = 0
var int days_exc_50_100 = 0
var int days_exc_100_200 = 0
var int days_exc_200plus = 0

if isOpenBar
    oh := high
    ol := low
    orange := high - low
    hitEither := false
    maxExcursionUp := 0.0
    maxExcursionDown := 0.0

postRTH = isAfter and not na(oh) and not isOpenBar

if postRTH and not hitEither
    if high > oh
        maxExcursionUp := math.max(maxExcursionUp, high - oh)
    if low < ol
        maxExcursionDown := math.max(maxExcursionDown, ol - low)
    if high >= oh or low <= ol
        hitEither := true
        excPre = math.max(maxExcursionUp, maxExcursionDown)
        if orange > 0 and excPre > 0
            sumExcAsPctRange += (excPre / orange) * 100.0
            hitDays += 1
            r = excPre / orange * 100.0
            if r <= 25
                days_exc_le_25 += 1
            else if r <= 50
                days_exc_25_50 += 1
            else if r <= 100
                days_exc_50_100 += 1
            else if r <= 200
                days_exc_100_200 += 1
            else
                days_exc_200plus += 1

isLastRthBar = h == 15 and m == 45
if isLastRthBar and not na(oh)
    totalDays += 1
