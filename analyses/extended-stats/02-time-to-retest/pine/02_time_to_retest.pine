//@version=5
indicator("02 Time To Retest", overlay=true)

h = hour(time, "America/New_York")
m = minute(time, "America/New_York")

isOpenBar = h == 9 and m == 30
isAfter = (h == 9 and m == 45) or (h == 10) or (h == 11) or (h == 12) or (h == 13) or (h == 14) or (h == 15)

var float oh = na
var float ol = na
var int barsAfter = 0
var bool hitEither = false

var int b1 = 0    // hit during 9:45-10:00
var int b2 = 0    // 10:00-10:15
var int b3 = 0    // 10:15-10:30
var int b4 = 0    // 10:30-10:45
var int b5to8 = 0
var int b9to16 = 0
var int b17plus = 0
var int never = 0
var int totalDays = 0
var int sumBarsHit = 0
var int hitDays = 0

if isOpenBar
    oh := high
    ol := low
    barsAfter := 0
    hitEither := false

postRTH = isAfter and not na(oh) and not isOpenBar

if postRTH
    barsAfter += 1
    if not hitEither
        if high >= oh or low <= ol
            hitEither := true
            hitDays += 1
            sumBarsHit += barsAfter
            if barsAfter == 1
                b1 += 1
            else if barsAfter == 2
                b2 += 1
            else if barsAfter == 3
                b3 += 1
            else if barsAfter == 4
                b4 += 1
            else if barsAfter <= 8
                b5to8 += 1
            else if barsAfter <= 16
                b9to16 += 1
            else
                b17plus += 1

isLastRthBar = h == 15 and m == 45
if isLastRthBar and not na(oh)
    totalDays += 1
    if not hitEither
        never += 1

// Output table omitted in saved copy
