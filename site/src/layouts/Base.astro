---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Trading-stats dashboard — retest probabilities and intraday structure across NQ, ES, GC futures.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-[--color-bg] text-[--color-text]">
    <header class="border-b border-[--color-border] bg-[--color-surface]">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href={base} class="flex items-center gap-2 font-semibold tracking-tight">
          <span class="text-[--color-accent]">◆</span>
          <span>Retest Stats</span>
        </a>
        <nav class="flex gap-4 text-sm text-[--color-text-dim]">
          <a href={base} class="hover:text-[--color-text]">Leaderboard</a>
          <a href={`${base}/analyses`} class="hover:text-[--color-text]">Analyses</a>
          <a href={`${base}/compare`} class="hover:text-[--color-text]">Compare</a>
          <a href={`${base}/methodology`} class="hover:text-[--color-text]">Methodology</a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>

    <footer class="mt-16 border-t border-[--color-border] px-4 py-6 text-center text-xs text-[--color-text-dim]">
      Built from the
      <a href="https://github.com/biagDev/data-collection" class="underline hover:text-[--color-text]">data-collection</a>
      repo. Data sourced from local TradingView Desktop — static snapshot, rebuilt on push.
    </footer>
  </body>
</html>
