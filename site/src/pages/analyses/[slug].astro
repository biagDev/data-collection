---
import { resolve } from 'node:path';
import Base from '../../layouts/Base.astro';
import AssetChip from '../../components/AssetChip.astro';
import analyses from '../../data/analyses.json';
import { renderMarkdownFile, readRepoText } from '../../lib/markdown.mjs';

export async function getStaticPaths() {
  // Defined inside getStaticPaths: Astro isolates this function's scope.
  const GITHUB_BLOB = 'https://github.com/biagDev/data-collection/blob/main';
  const base = import.meta.env.BASE_URL;
  // astro build runs with cwd = site/, so repo root is one level up.
  const repoRoot = resolve(process.cwd(), '..');
  const opts = { base, githubBlobBase: GITHUB_BLOB };

  const out = [];
  for (const record of analyses) {
    const easyRead = await renderMarkdownFile(repoRoot, record.paths.easyRead, opts);
    const readme = await renderMarkdownFile(repoRoot, record.paths.readme, opts);
    const pineSource = await readRepoText(repoRoot, record.paths.pine);
    out.push({
      params: { slug: record.slug },
      props: {
        record,
        easyReadHtml: easyRead?.html ?? null,
        readmeHtml: readme?.html ?? null,
        pineSource,
      },
    });
  }
  return out;
}

const GITHUB_BLOB = 'https://github.com/biagDev/data-collection/blob/main';
const { record, easyReadHtml, readmeHtml, pineSource } = Astro.props;
const base = import.meta.env.BASE_URL;
const ghBlob = `${GITHUB_BLOB}/${record.paths.dir}`;

const hasEasy = !!easyReadHtml;
const hasReadme = !!readmeHtml;
const hasBothDocs = hasEasy && hasReadme;

const pct = (v) => (v == null ? '—' : v.toFixed(2));
const biasColor = (b) =>
  b === 'high' ? 'var(--color-pos)' : b === 'low' ? 'var(--color-neg)' : 'var(--color-text-dim)';
---

<Base title={`${record.title} — Retest Stats`} description={record.headline}>
  <!-- Breadcrumb -->
  <div class="mb-3 text-xs text-[--color-text-dim]">
    <a href={`${base}/analyses`} class="hover:text-[--color-text]">Analyses</a>
    <span class="mx-1">/</span>
    <span>{record.title}</span>
  </div>

  <!-- Header -->
  <header class="rounded-lg border border-[--color-border] bg-[--color-surface] p-5">
    <div class="flex flex-wrap items-center gap-2">
      <AssetChip asset={record.asset} />
      <span class="text-[11px] uppercase tracking-wide text-[--color-text-dim]">{record.categoryLabel}</span>
      {record.sessionLabel && (
        <span class="text-[11px] uppercase tracking-wide text-[--color-text-dim]">· {record.sessionLabel}</span>
      )}
    </div>
    <h1 class="mt-1.5 text-2xl font-semibold tracking-tight">{record.title}</h1>
    {record.headline && <p class="mt-1.5 max-w-3xl text-sm text-[--color-text-dim]">{record.headline}</p>}
    <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs text-[--color-text-dim]">
      <span>Symbol <span class="tabular text-[--color-text]">{record.symbol || '—'}</span></span>
      <span>Timeframe <span class="tabular text-[--color-text]">{record.timeframe}</span></span>
      <span>Sample <span class="tabular text-[--color-text]">{record.sampleLabel}</span></span>
      <span>As of <span class="tabular text-[--color-text]">{record.asOf || '—'}</span></span>
    </div>
  </header>

  <!-- Notes -->
  {record.notes && record.notes.length > 0 && (
    <div class="mt-4 space-y-2">
      {record.notes.map((note) => (
        <div class="rounded border border-[--color-border] bg-[--color-surface-2] p-3 text-sm">
          <span class="text-xs font-semibold uppercase tracking-wide text-[--color-accent]">{note.label}</span>
          <p class="mt-0.5 text-[--color-text-dim]">{note.text}</p>
        </div>
      ))}
    </div>
  )}

  <!-- Normalized candle data (retest analyses only) -->
  {record.candles && record.candles.length > 0 && (
    <section class="mt-6">
      <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-[--color-text-dim]">Candle data</h2>
      <div class="overflow-x-auto rounded-lg border border-[--color-border]">
        <table class="w-full border-collapse text-sm">
          <thead class="bg-[--color-surface-2] text-[--color-text-dim]">
            <tr>
              <th class="px-3 py-2 text-left font-medium">Candle</th>
              <th class="px-3 py-2 text-right font-medium">n</th>
              <th class="px-3 py-2 text-right font-medium">Retest +15</th>
              <th class="px-3 py-2 text-right font-medium">Retest +30</th>
              <th class="px-3 py-2 text-right font-medium">Retest +45</th>
              <th class="px-3 py-2 text-right font-medium">Sweep +15</th>
              <th class="px-3 py-2 text-right font-medium">Sweep +30</th>
              <th class="px-3 py-2 text-right font-medium">Sweep +45</th>
              <th class="px-3 py-2 text-right font-medium">Hi-any +45</th>
              <th class="px-3 py-2 text-right font-medium">Lo-any +45</th>
              <th class="px-3 py-2 text-left font-medium">Bias</th>
            </tr>
          </thead>
          <tbody>
            {record.candles.map((c) => (
              <tr class="border-t border-[--color-border]">
                <td class="px-3 py-2 tabular">{c.label}</td>
                <td class="px-3 py-2 text-right tabular text-[--color-text-dim]">{c.n ?? '—'}</td>
                <td class="px-3 py-2 text-right tabular">{pct(c.retest.p15)}</td>
                <td class="px-3 py-2 text-right tabular">{pct(c.retest.p30)}</td>
                <td class="px-3 py-2 text-right tabular">{pct(c.retest.p45)}</td>
                <td class="px-3 py-2 text-right tabular text-[--color-text-dim]">{pct(c.sweep.p15)}</td>
                <td class="px-3 py-2 text-right tabular text-[--color-text-dim]">{pct(c.sweep.p30)}</td>
                <td class="px-3 py-2 text-right tabular text-[--color-text-dim]">{pct(c.sweep.p45)}</td>
                <td class="px-3 py-2 text-right tabular text-[--color-text-dim]">{pct(c.highAny45)}</td>
                <td class="px-3 py-2 text-right tabular text-[--color-text-dim]">{pct(c.lowAny45)}</td>
                <td class="px-3 py-2"><span class="text-xs" style={`color:${biasColor(c.bias)}`}>{c.bias ?? ''}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- Write-up: EASY_READ (plain English) + README (technical) -->
  {(hasEasy || hasReadme) && (
    <section class="mt-6">
      {hasBothDocs && (
        <div class="mb-3 flex gap-1 text-sm" id="doc-tabs">
          <button data-doc="easy" data-active class="rounded border border-[--color-border] bg-[--color-surface-2] px-3 py-1 data-[active]:border-[--color-accent] data-[active]:text-[--color-accent]">
            Plain English
          </button>
          <button data-doc="tech" class="rounded border border-[--color-border] bg-[--color-surface-2] px-3 py-1 data-[active]:border-[--color-accent] data-[active]:text-[--color-accent]">
            Technical
          </button>
        </div>
      )}
      {hasEasy && (
        <article id="doc-easy" class="prose rounded-lg border border-[--color-border] bg-[--color-surface] p-5" set:html={easyReadHtml} />
      )}
      {hasReadme && (
        <article id="doc-tech" class={`prose rounded-lg border border-[--color-border] bg-[--color-surface] p-5 ${hasBothDocs ? 'hidden' : ''}`} set:html={readmeHtml} />
      )}
    </section>
  )}

  {!hasEasy && !hasReadme && (
    <p class="mt-6 rounded-lg border border-[--color-border] bg-[--color-surface] p-5 text-sm text-[--color-text-dim]">
      No write-up file ships with this analysis — see the structured data above, the notes,
      and the raw <a href={`${GITHUB_BLOB}/${record.paths.resultsJson}`} class="text-[--color-accent] hover:underline">results.json</a> on GitHub.
    </p>
  )}

  <!-- Pine source -->
  {pineSource && (
    <details class="mt-6 rounded-lg border border-[--color-border] bg-[--color-surface]">
      <summary class="cursor-pointer px-5 py-3 text-sm font-semibold">Pine Script source</summary>
      <pre class="tabular overflow-x-auto border-t border-[--color-border] bg-[--color-bg] p-4 text-xs leading-relaxed"><code>{pineSource}</code></pre>
    </details>
  )}

  <!-- Source links -->
  <div class="mt-6 flex flex-wrap gap-3 text-xs text-[--color-text-dim]">
    <a href={ghBlob} class="rounded border border-[--color-border] px-2.5 py-1 hover:border-[--color-accent] hover:text-[--color-text]">Folder on GitHub →</a>
    <a href={`${GITHUB_BLOB}/${record.paths.resultsJson}`} class="rounded border border-[--color-border] px-2.5 py-1 hover:border-[--color-accent] hover:text-[--color-text]">results.json</a>
    {record.paths.pine && <a href={`${GITHUB_BLOB}/${record.paths.pine}`} class="rounded border border-[--color-border] px-2.5 py-1 hover:border-[--color-accent] hover:text-[--color-text]">Pine source</a>}
  </div>
</Base>

<script>
  const tabs = document.getElementById('doc-tabs');
  if (tabs) {
    const easy = document.getElementById('doc-easy');
    const tech = document.getElementById('doc-tech');
    tabs.querySelectorAll('button').forEach((btn) => {
      btn.addEventListener('click', () => {
        const which = btn.getAttribute('data-doc');
        tabs.querySelectorAll('button').forEach((b) => b.removeAttribute('data-active'));
        btn.setAttribute('data-active', '');
        if (easy) easy.classList.toggle('hidden', which !== 'easy');
        if (tech) tech.classList.toggle('hidden', which !== 'tech');
      });
    });
  }
</script>
